# Server-only secrets for `supabase functions serve whiteboard-write --env-file ...`.
# Never expose these as VITE_* variables or commit real values.
WHITEBOARD_HASH_SALT=replace-with-a-long-random-secret
WHITEBOARD_WRITE_ENABLED=false
WHITEBOARD_ALLOWED_ORIGINS=http://localhost:5171,https://your-domain.example
