# 复制为 .env.local 后填写真实值；不要把 .env.local 提交到 Git。
# 这里只能放浏览器公开配置，不能放 service-role 或哈希盐。

# local：每个浏览器独立保存；supabase：公开只读、投稿审核后展示
VITE_WHITEBOARD_MODE=supabase

# Supabase Dashboard → Project Settings → API Keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# 如果控制台只显示旧版 anon key，也可以使用这个变量名：
# VITE_SUPABASE_ANON_KEY=your-anon-key

VITE_WHITEBOARD_WRITE_FUNCTION=whiteboard-write
